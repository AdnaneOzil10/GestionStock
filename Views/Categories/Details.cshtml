@model Categorie
@{
    ViewData["Title"] = "Détail catégorie";
}
<div class="card shadow-sm">
    <div class="card-header bg-info text-white"><i class="bi bi-eye"></i> Détail de la catégorie</div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Nom</dt>
            <dd class="col-sm-9">@Model.Nom</dd>
            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@Model.Description</dd>
        </dl>

        <h5 class="mt-4">Produits de cette catégorie (@Model.Produits.Count)</h5>
        @if (Model.Produits.Any())
        {
            <ul class="list-group">
                @foreach (var p in Model.Produits)
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <a asp-controller="Produits" asp-action="Details" asp-route-id="@p.Id">@p.Nom</a>
                        <span>@p.Prix.ToString("N2") DH</span>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">Aucun produit.</p>
        }
    </div>
    <div class="card-footer">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="bi bi-pencil"></i> Modifier</a>
        <a asp-action="Index" class="btn btn-secondary">Retour</a>
    </div>
</div>
