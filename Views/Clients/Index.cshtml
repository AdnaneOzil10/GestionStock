@model ClientRecherche
@{
    ViewData["Title"] = "Clients";
}
<div class="page-header">
    <h1><i class="bi bi-people text-danger"></i> Clients</h1>
    <a asp-action="Create" class="btn btn-danger"><i class="bi bi-person-plus"></i> Nouveau client</a>
</div>

<!-- Zone de recherche avancée -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-white">
        <a class="text-decoration-none fw-semibold" data-bs-toggle="collapse" href="#rechercheAvancee">
            <i class="bi bi-search"></i> Recherche avancée <i class="bi bi-chevron-down small"></i>
        </a>
    </div>
    <div id="rechercheAvancee" class="collapse show">
        <div class="card-body">
            <form asp-action="Index" method="get">
                <div class="row g-3">
                    <div class="col-md-2">
                        <label asp-for="Id" class="form-label">N°</label>
                        <input asp-for="Id" class="form-control" type="number" min="1" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Nom" class="form-label"></label>
                        <input asp-for="Nom" class="form-control" placeholder="contient..." />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Prenom" class="form-label"></label>
                        <input asp-for="Prenom" class="form-control" placeholder="contient..." />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" type="text" placeholder="contient..." />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Telephone" class="form-label"></label>
                        <input asp-for="Telephone" class="form-control" type="text" placeholder="contient..." />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Ville" class="form-label"></label>
                        <input asp-for="Ville" class="form-control" placeholder="contient..." />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Âge (min - max)</label>
                        <div class="input-group">
                            <input asp-for="AgeMin" class="form-control" type="number" min="0" placeholder="min" />
                            <input asp-for="AgeMax" class="form-control" type="number" min="0" placeholder="max" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Date d'inscription (du - au)</label>
                        <div class="input-group">
                            <input asp-for="DateDebut" class="form-control" />
                            <input asp-for="DateFin" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="mt-3">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Rechercher</button>
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-circle"></i> Réinitialiser</a>
                </div>
            </form>
        </div>
    </div>
</div>

<p class="text-muted">
    @Model.Resultats.Count client(s) @(Model.EstVide ? "au total" : "trouvé(s) selon vos critères")
</p>

<div class="card shadow-sm">
    <div class="card-body p-0 table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-danger">
                <tr>
                    <th>N°</th>
                    <th>Nom</th>
                    <th>Prénom</th>
                    <th>Email</th>
                    <th>Téléphone</th>
                    <th>Ville</th>
                    <th class="text-center">Âge</th>
                    <th>Inscription</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Resultats.Any())
                {
                    <tr><td colspan="9" class="text-center text-muted py-4">Aucun client trouvé.</td></tr>
                }
                @foreach (var item in Model.Resultats)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td class="fw-semibold">@item.Nom</td>
                        <td>@item.Prenom</td>
                        <td>@item.Email</td>
                        <td>@item.Telephone</td>
                        <td>@item.Ville</td>
                        <td class="text-center">@item.Age</td>
                        <td>@item.DateInscription.ToString("dd/MM/yyyy")</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Détail"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Modifier"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Supprimer"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
