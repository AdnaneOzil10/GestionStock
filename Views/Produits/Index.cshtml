@model IEnumerable<Produit>
@{
    ViewData["Title"] = "Produits";
}
<div class="page-header">
    <h1><i class="bi bi-bag text-success"></i> Produits</h1>
    <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-circle"></i> Nouveau produit</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-success">
                <tr>
                    <th>Nom</th>
                    <th>Catégorie</th>
                    <th class="text-end">Prix</th>
                    <th class="text-center">Quantité</th>
                    <th>Date d'ajout</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Aucun produit.</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.Nom</td>
                        <td><span class="badge bg-primary">@item.Categorie?.Nom</span></td>
                        <td class="text-end">@item.Prix.ToString("N2") DH</td>
                        <td class="text-center">@item.Quantite</td>
                        <td>@item.DateAjout.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Détail"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Modifier"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Supprimer"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
