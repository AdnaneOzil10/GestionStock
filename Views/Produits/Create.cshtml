@model Produit
@{
    ViewData["Title"] = "Nouveau produit";
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white"><i class="bi bi-plus-circle"></i> Nouveau produit</div>
            <div class="card-body">
                <form asp-action="Create">
                    <partial name="_Form" model="Model" />
                    <button type="submit" class="btn btn-success"><i class="bi bi-save"></i> Enregistrer</button>
                    <a asp-action="Index" class="btn btn-secondary">Retour</a>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
