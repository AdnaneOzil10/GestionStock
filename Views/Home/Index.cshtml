@{
    ViewData["Title"] = "Accueil";
}
<div class="page-header">
    <h1>Tableau de bord</h1>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card shadow-sm stat-card">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted">Catégories</h6>
                    <h2 class="fw-bold">@ViewBag.NbCategories</h2>
                    <a asp-controller="Categories" asp-action="Index" class="btn btn-sm btn-outline-primary">Gérer</a>
                </div>
                <i class="bi bi-tags text-primary"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm stat-card">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted">Produits</h6>
                    <h2 class="fw-bold">@ViewBag.NbProduits</h2>
                    <a asp-controller="Produits" asp-action="Index" class="btn btn-sm btn-outline-success">Gérer</a>
                </div>
                <i class="bi bi-bag text-success"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm stat-card">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted">Clients</h6>
                    <h2 class="fw-bold">@ViewBag.NbClients</h2>
                    <a asp-controller="Clients" asp-action="Index" class="btn btn-sm btn-outline-danger">Rechercher</a>
                </div>
                <i class="bi bi-people text-danger"></i>
            </div>
        </div>
    </div>
</div>
