@model Produit
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="mb-3">
    <label asp-for="Nom" class="form-label"></label>
    <input asp-for="Nom" class="form-control" />
    <span asp-validation-for="Nom"></span>
</div>
<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Prix" class="form-label"></label>
        <div class="input-group">
            <input asp-for="Prix" class="form-control" type="number" step="0.01" min="0" />
            <span class="input-group-text">DH</span>
        </div>
        <span asp-validation-for="Prix"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Quantite" class="form-label"></label>
        <input asp-for="Quantite" class="form-control" min="0" />
        <span asp-validation-for="Quantite"></span>
    </div>
</div>
<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="DateAjout" class="form-label"></label>
        <input asp-for="DateAjout" class="form-control" />
        <span asp-validation-for="DateAjout"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="CategorieId" class="form-label"></label>
        <select asp-for="CategorieId" class="form-select" asp-items="ViewBag.CategorieId">
            <option value="">-- Choisir une catégorie --</option>
        </select>
        <span asp-validation-for="CategorieId"></span>
    </div>
</div>
