@{
    ViewData["Title"] = "Erreur";
}
<div class="text-center py-5">
    <i class="bi bi-bug display-1 text-danger"></i>
    <h2 class="mt-3">Une erreur est survenue</h2>
    <p class="text-muted">@(ViewBag.Message ?? "Veuillez réessayer plus tard.")</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Retour à l'accueil</a>
</div>
